# Every value enters through voiceup_inference.config.Settings.
VOICEUP_INFERENCE_INTERNAL_KEY=<provide-at-least-32-random-bytes>
VOICEUP_INFERENCE_MODEL_DIR=/models/speaker
VOICEUP_INFERENCE_DEVICE=cuda:0
VOICEUP_INFERENCE_RUNTIME_PROFILE=x86_64-cu128
# Explicit CPU mode pairs DEVICE=cpu with x86_64-cpu or aarch64-cpu.
# Use scripts/setup-local-cpu.py for the matching offline image and Compose profile.
VOICEUP_INFERENCE_MAX_UPLOAD_BYTES=52428800
VOICEUP_INFERENCE_MAX_DURATION_SECONDS=120
VOICEUP_INFERENCE_HOST=0.0.0.0
VOICEUP_INFERENCE_PORT=8090

# voiceup backend development settings. Copy to .env; never commit .env.
VOICEUP_ENVIRONMENT=development
VOICEUP_DEBUG=true
VOICEUP_LOG_LEVEL=INFO
VOICEUP_PROJECT_NAME=voiceup

VOICEUP_API_PREFIX=/api/voiceup/v1
VOICEUP_TENANT_HEADER=x-tenant-id
VOICEUP_CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:8081

VOICEUP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voiceup

# Replace for every shared/deployed environment. The known development default is rejected there.
VOICEUP_JWT_SECRET=development-only-change-me-at-least-32-bytes
VOICEUP_JWT_ALGORITHM=HS256
VOICEUP_JWT_ISSUER=voiceup
VOICEUP_JWT_AUDIENCE=voiceup-api
VOICEUP_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional local-only sign-in; startup rejects enabling this outside development.
VOICEUP_LOCAL_ADMIN_LOGIN_ENABLED=false
# Empty selects exactly one active super admin; otherwise use this exact username.
VOICEUP_LOCAL_ADMIN_USERNAME=

VOICEUP_BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.invalid
VOICEUP_BOOTSTRAP_SUPER_ADMIN_USERNAME=super-admin
# Supply VOICEUP_BOOTSTRAP_SUPER_ADMIN_PASSWORD only in the command process environment.
# Do not add the password to this file or version control.

# Accepted local speaker pilot
VOICEUP_AUDIO_STORAGE_PATH=/data/audio
VOICEUP_AUDIO_MAX_BYTES=52428800
VOICEUP_AUDIO_MAX_SECONDS=120
VOICEUP_AUDIO_RETENTION_HOURS=24
VOICEUP_JOB_RETENTION_DAYS=7
VOICEUP_INFERENCE_URL=http://inference:8090
VOICEUP_JOB_TIMEOUT_SECONDS=300
VOICEUP_WORKER_POLL_SECONDS=2.0
VOICEUP_CLEANUP_INTERVAL_SECONDS=3600
VOICEUP_SPEAKER_MATCH_THRESHOLD=0.55
VOICEUP_SPEAKER_NEW_THRESHOLD=0.45
VOICEUP_SPEAKER_MATCH_MARGIN=0.10
# Uploaded meetings use the audio volume's separate meetings subdirectory.
VOICEUP_MEETING_MAX_BYTES=2147483648
VOICEUP_MEETING_MAX_SECONDS=14400
VOICEUP_MEETING_TENANT_MAX_BYTES=10737418240
VOICEUP_MEETING_ACTIVE_UPLOADS=2
VOICEUP_MEETING_SOURCE_RETENTION_DAYS=7
VOICEUP_MEETING_RESULT_RETENTION_DAYS=30
VOICEUP_MEETING_UPLOAD_RETENTION_HOURS=24
VOICEUP_MEETING_CHUNK_TIMEOUT_SECONDS=600
# Supply VOICEUP_INFERENCE_KEY from the same pre-created secret as the inference service.

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:agent-policy:1.0",
  "title": "Canonical Agent Policy Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "metadata",
    "lineage",
    "failure_mode",
    "controls"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "AgentPolicyPack"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "owner", "lifecycle"],
      "properties": {
        "id": {"$ref": "#/$defs/policyRef"},
        "version": {"$ref": "#/$defs/semver"},
        "owner": {"$ref": "#/$defs/ownerRef"},
        "lifecycle": {"const": "draft"}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "authoritative", "normalization_status"],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^external-seed:desktop-agents/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "authoritative": {"const": false},
        "normalization_status": {"const": "canonical-normalized"}
      }
    },
    "failure_mode": {"enum": ["finding", "manual-review"]},
    "controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/control"}
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "ownerRef": {
      "type": "string",
      "pattern": "^(?:team|person):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "policyRef": {
      "type": "string",
      "pattern": "^policy:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "enforcement", "on_failure"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$"
        },
        "statement": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500,
          "pattern": "^(?!.*[\\r\\n]).*\\S.*$"
        },
        "enforcement": {
          "enum": ["instruction", "schema", "deterministic-check", "isolated-runner", "human-gate"]
        },
        "on_failure": {"enum": ["finding", "manual-review"]}
      }
    }
  }
}

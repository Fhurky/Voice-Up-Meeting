# @@PRODUCT_SLUG@@ backend development settings. Copy to .env; never commit .env.
@@ENV_PREFIX@@ENVIRONMENT=development
@@ENV_PREFIX@@DEBUG=true
@@ENV_PREFIX@@LOG_LEVEL=INFO
@@ENV_PREFIX@@PROJECT_NAME=@@PRODUCT_SLUG@@

@@ENV_PREFIX@@API_PREFIX=@@API_PREFIX@@
@@ENV_PREFIX@@TENANT_HEADER=@@TENANT_HEADER@@
@@ENV_PREFIX@@CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080

@@ENV_PREFIX@@DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/@@PRODUCT_SLUG@@

# Replace for every shared/deployed environment. The known development default is rejected there.
@@ENV_PREFIX@@JWT_SECRET=development-only-change-me-at-least-32-bytes
@@ENV_PREFIX@@JWT_ALGORITHM=HS256
@@ENV_PREFIX@@JWT_ISSUER=@@PRODUCT_SLUG@@
@@ENV_PREFIX@@JWT_AUDIENCE=@@PRODUCT_SLUG@@-api
@@ENV_PREFIX@@ACCESS_TOKEN_EXPIRE_MINUTES=60

@@ENV_PREFIX@@BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.invalid
@@ENV_PREFIX@@BOOTSTRAP_SUPER_ADMIN_USERNAME=super-admin
# Supply @@ENV_PREFIX@@BOOTSTRAP_SUPER_ADMIN_PASSWORD only in the command process environment.
# Do not add the password to this file or version control.

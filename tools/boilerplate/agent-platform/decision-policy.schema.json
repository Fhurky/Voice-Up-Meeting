{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kt:agent-platform:decision-policy:1.0",
  "title": "Deterministic Review Decision Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "metadata",
    "lineage",
    "claim_boundary",
    "required_workers",
    "weights",
    "thresholds",
    "fail_closed",
    "decisions"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "DeterministicDecisionPolicy"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "owner", "lifecycle"],
      "properties": {
        "id": {"const": "policy:governed-review-aggregation"},
        "version": {"$ref": "#/$defs/semver"},
        "owner": {"$ref": "#/$defs/ownerRef"},
        "lifecycle": {"const": "draft"}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "authoritative", "normalization_status"],
      "properties": {
        "source": {"const": "external-seed:desktop-agents/supervisor"},
        "authoritative": {"const": false},
        "normalization_status": {"const": "canonical-normalized"}
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_admission", "production_decision", "note"],
      "properties": {
        "runtime_admission": {"const": false},
        "production_decision": {"const": false},
        "note": {"type": "string", "minLength": 20, "maxLength": 500}
      }
    },
    "required_workers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/agentRef"}
    },
    "weights": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "additionalProperties": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
      "propertyNames": {"pattern": "^agent:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fail_score", "warning_score", "confidence_floor", "compliance_baseline"],
      "properties": {
        "fail_score": {"type": "number", "minimum": 0, "maximum": 100},
        "warning_score": {"type": "number", "minimum": 0, "maximum": 100},
        "confidence_floor": {"type": "number", "minimum": 0, "maximum": 1},
        "compliance_baseline": {"const": 100}
      }
    },
    "fail_closed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missing_worker", "timeout", "invalid_schema", "integrity_failure", "unknown_policy_version"],
      "properties": {
        "missing_worker": {"const": "MANUAL_REVIEW"},
        "timeout": {"const": "MANUAL_REVIEW"},
        "invalid_schema": {"const": "MANUAL_REVIEW"},
        "integrity_failure": {"const": "MANUAL_REVIEW"},
        "unknown_policy_version": {"const": "MANUAL_REVIEW"}
      }
    },
    "decisions": {
      "type": "array",
      "const": ["PASS", "WARNING", "FAIL", "MANUAL_REVIEW"]
    }
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "ownerRef": {"type": "string", "pattern": "^(?:team|person):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "agentRef": {"type": "string", "pattern": "^agent:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}
  }
}
